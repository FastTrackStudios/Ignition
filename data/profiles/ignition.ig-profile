{
  "about": "The default profile. Three required layers, three required focus points, and one canvas where a room has screens. Everything else is optional or inherited, because every required role is a barrier to a room implementing this and a profile only a large rig can satisfy has failed at being a default. Stage areas are deliberately NOT declared here: a club has three and a stadium with a thrust and a B-stage has fifteen, so no central list is right. The portable 'where is the talent' question is answered by the Vocal / Stage / Band focus roles; the venue owns its own blocking grid.",
  "bundles": {
    "breakdown embers": {
      "about": "fire flicker on the wash, candles on the floor and the colour flushing between red and amber — a breakdown down to embers",
      "family": "breakdown",
      "name": "breakdown embers",
      "recipes": [
        "fire flicker",
        "candle",
        "colour fire"
      ]
    },
    "bridge hush": {
      "about": "dark sparkle over a split warm and cool wash while the movers nod — a bridge that pulls the room in rather than pushing at it",
      "family": "bridge",
      "name": "bridge hush",
      "recipes": [
        "dark sparkle",
        "nod",
        "warm cool split"
      ]
    },
    "build tension": {
      "about": "a sawtooth pulse under a rolling tilt wave with the strobes ticking underneath — the riser before a drop",
      "family": "build",
      "name": "build tension",
      "recipes": [
        "ramp pulse",
        "tilt wave",
        "strobe bed"
      ]
    },
    "chorus drive": {
      "about": "a chase across the wash, a windmill on the movers and two colours stepping through — the default chorus, the one to reach for first",
      "family": "chorus",
      "name": "chorus drive",
      "recipes": [
        "chase",
        "windmill",
        "two colour chase"
      ]
    },
    "chorus lift": {
      "about": "everything pulsing together under a figure of eight while the beams breathe with the beat — a chorus that wants to be big rather than busy",
      "family": "chorus",
      "name": "chorus lift",
      "recipes": [
        "pulse",
        "figure eight",
        "zoom pulse"
      ]
    },
    "drop": {
      "about": "a strobe burst, the blinders hitting the room and the movers flying out — the downbeat of the drop, fired once",
      "family": "drop",
      "name": "drop",
      "recipes": [
        "strobe burst",
        "blinder hit",
        "fly out"
      ]
    },
    "drop and hold": {
      "about": "a beat pulse under a ballyhoo in both position and colour with the bars strobing — the bars after the drop, as loud as the library goes",
      "family": "drop",
      "name": "drop and hold",
      "recipes": [
        "beat pulse",
        "ballyhoo",
        "colour ballyhoo",
        "strip strobe"
      ]
    },
    "intro reveal": {
      "about": "the stage filling to its look while the movers fly in over a slow rainbow on the bars — the first bar of the show",
      "family": "intro",
      "name": "intro reveal",
      "recipes": [
        "fill and hold",
        "fly in",
        "rainbow scroll"
      ]
    },
    "outro fade": {
      "about": "the stage draining to a glow while the movers lift off and the colour fades between two hues — the last bars, held until the cue drops",
      "family": "outro",
      "name": "outro fade",
      "recipes": [
        "drain and hold",
        "lift off",
        "two colour fade"
      ]
    },
    "pre chorus rise": {
      "about": "the wash filling up fixture by fixture as the movers fan open and an iris pinch runs the rig — the eight bars before a chorus",
      "family": "build",
      "name": "pre chorus rise",
      "recipes": [
        "build",
        "pan fan",
        "iris chase"
      ]
    },
    "verse bed": {
      "about": "the wash breathing slowly under a circle that swells and shrinks with it — every verse, the thing under the vocal",
      "family": "verse",
      "name": "verse bed",
      "recipes": [
        "breathe",
        "circle breathe"
      ]
    },
    "verse drift": {
      "about": "fixtures breathing out of step while the movers sway and the colour drifts in and out of saturation — a second verse that wants to move without lifting",
      "family": "verse",
      "name": "verse drift",
      "recipes": [
        "offset breathe",
        "sway",
        "saturation breathe"
      ]
    }
  },
