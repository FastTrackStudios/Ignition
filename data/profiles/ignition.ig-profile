  "effect_notes": {
    "alternate": {
      "about": "odds and evens trading places every half bar — verses that want a pulse without travel",
      "family": "intensity"
    },
    "audience sweep": {
      "about": "the beams grazing slowly across the crowd and back over four bars — last choruses and outros",
      "family": "movement"
    },
    "back breathe": {
      "about": "the back wall swelling gently over four bars under everything else — verses, felt not seen",
      "family": "intensity"
    },
    "ballyhoo": {
      "about": "beams roaming the room in a loop that never quite repeats — choruses and last choruses",
      "family": "movement"
    },
    "bar sparkle": {
      "about": "single pixels lifting in a scattered order across the bars — pre-choruses and ballad choruses",
      "family": "strip"
    },
    "bar tick": {
      "about": "the bars lifting a little on every beat under the wash — verses that want a pulse without motion",
      "family": "strip"
    },
    "beat pulse": {
      "about": "a short dip on every beat with the wash mostly up — choruses that want a click rather than a swell",
      "family": "intensity"
    },
    "blinder chase": {
      "about": "the blinders alternating odds and evens at eighths, white — drops, a few bars at most",
      "family": "intensity"
    },
    "blinder hit": {
      "about": "the blinders hitting the room white and fading over two beats — the downbeat of a last chorus, three hits at most",
      "family": "one-shot"
    },
    "bounce": {
      "about": "a wave of light washing to the end of the rig and back every two bars — bridges, never jumps",
      "family": "intensity"
    },
    "breathe": {
      "about": "the whole wash swelling slowly over four bars — verses and bridges, movement without being busy",
      "family": "intensity"
    },
    "build": {
      "about": "the wash filling one light at a time over two bars, then resetting — pre-choruses and risers",
      "family": "intensity"
    },
    "bump": {
      "about": "the wash snapping up and falling straight back — every charted hit, snares and stabs",
      "family": "one-shot"
    },
    "can can": {
      "about": "beams kicking left and right on the beat while they rise and fall, odds against evens — last choruses",
      "family": "movement"
    },
    "candle": {
      "about": "the key light wavering slowly and slightly like a candle, never quite still — ballads and the quietest intros",
      "family": "intensity"
    },
    "centre burst": {
      "about": "a burst of light leaving the centre of the bars for both ends and gone — hits and downbeats",
      "family": "one-shot"
    },
    "chase": {
      "about": "one point of light travelling across the wash once a bar — choruses, any rig",
      "family": "intensity"
    },
    "chase eighths": {
      "about": "the chase at twice the pace, a point of light crossing every half bar — last choruses and drops",
      "family": "intensity"
    },
    "circle": {
      "about": "every beam drawing a slow, wide circle round its focus over four bars — verses, motion that is not an effect",
      "family": "movement"
    },
    "circle breathe": {
      "about": "a slow circle that dims on the far side of the arc, so the beams seem to go away and come back — verses",
      "family": "movement"
    },
    "circle tight": {
      "about": "a small quick circle round the focus every two bars — choruses, busier than circle",
      "family": "movement"
    },
    "cold chase": {
      "about": "sky, blue, lavender and cyan walking along the wash like ice over four bars — intros and cool bridges",
      "family": "colour"
    },
    "colour ballyhoo": {
      "about": "every light snapping through the palette in a scattered order every two bars — party choruses",
      "family": "colour"
    },
    "colour bump": {
      "about": "the wash flushing hot for a moment and settling back to its colour — hits in a section that is already bright",
      "family": "one-shot"
    },
    "colour cycle": {
      "about": "the whole wash drifting round the spectrum together over four bars — outros and ambient verses, over white or a pale look",
      "family": "colour"
    },
    "colour fire": {
      "about": "an amber look guttering between red and orange, different everywhere — under a warm look in intros and bridges",
      "family": "colour"
    },
    "colour sparkle": {
      "about": "single lights glinting to the hot colour on a deep base in a scattered order — pre-choruses and outros",
      "family": "colour"
    },
    "colour stripes": {
      "about": "the wash striped in pairs of each palette colour, the stripes swapping every two bars — choruses",
      "family": "colour"
    },
    "colour wipe": {
      "about": "the hot colour sweeping across the wash over a bar and staying — a section change that wants to be seen arriving",
      "family": "one-shot"
    },
    "comet": {
      "about": "a bright head with a fading tail streaking along the bars once a bar — pre-choruses and choruses",
      "family": "strip"
    },
    "counter circle": {
      "about": "the two halves of the rig circling opposite ways so the beams meet and part over four bars — choruses and outros",
      "family": "movement"
    },
    "cross": {
      "about": "odd beams swinging one way as even beams swing the other, crossing every two bars — choruses",
      "family": "movement"
    },
    "cyc wave": {
      "about": "one swell of light rolling across the back wall and bars and gone — cymbal swells and section changes",
      "family": "one-shot"
    },
    "dark chase": {
      "about": "a dark hole travelling across a lit wash once a bar — choruses on a full stage, motion without more light",
      "family": "intensity"
    },
    "dark sparkle": {
      "about": "single lights blinking out of a lit wash in a scattered order — full-stage choruses that want texture",
      "family": "intensity"
    },
    "defocus wave": {
      "about": "a soft patch travelling through a line of sharp gobos over four bars — bridges and outros",
      "family": "beam"
    },
    "dissolve": {
      "about": "the bars' pixels dropping out one by one in a scattered order over two bars and staying dark — outros",
      "family": "one-shot"
    },
    "drain": {
      "about": "the wash emptying one light at a time over two bars, then resetting — ends of sections, outros",
      "family": "intensity"
    },
    "drain and hold": {
      "about": "the wash going out light by light over a bar and staying dark — the end of a section, a breakdown arriving",
      "family": "one-shot"
    },
    "drum ring": {
      "about": "beams circling a metre round the drummer, spread so they chase each other round the kit every two bars — drum breaks",
      "family": "movement"
    },
    "dual scanner": {
      "about": "two comets leaving the centre of the bars for both ends and coming back — choruses, symmetric",
      "family": "strip"
    },
    "figure eight": {
      "about": "every beam tracing a figure of eight over four bars — verses and bridges, lazier than a circle",
      "family": "movement"
    },
    "fill and hold": {
      "about": "the wash filling light by light over a bar and staying full — a chorus that arrives rather than cuts",
      "family": "one-shot"
    },
    "fire flicker": {
      "about": "the wash guttering like firelight, every fixture at its own rate — under an amber look in intros and bridges",
      "family": "intensity"
    },
    "floor eight": {
      "about": "every beam tracing a three metre figure of eight on the floor over four bars — bridges, the eight in the room",
      "family": "movement"
    },
    "fly in": {
      "about": "the beams dropping from high and dim onto their focus at full over a bar — a chorus landing",
      "family": "one-shot"
    },
    "fly out": {
      "about": "beams rising and opening wide together, then settling back, over four bars — choruses and outros",
      "family": "movement"
    },
    "focus breathe": {
      "about": "gobos drifting in and out of sharpness together over four bars — intros and bridges, texture rather than motion",
      "family": "beam"
    },
    "gobo shake": {
      "about": "the gobo wheel jittering at the edge of its slot so the pattern shivers — drops and breakdowns",
      "family": "beam"
    },
    "gobo step": {
      "about": "odd and even beams trading between two gobos every two bars — bridges and intros that want texture",
      "family": "beam"
    },
    "head bang": {
      "about": "beams snapping up and falling back, odds against evens, once a bar — heavy choruses and drops",
      "family": "movement"
    },
    "heartbeat": {
      "about": "two quick lifts and a rest every two bars — intros, breakdowns and anything tense",
      "family": "intensity"
    },
    "hue rock": {
      "about": "the look leaning warmer then cooler around its own colour over four bars — verses, felt not seen",
      "family": "colour"
    },
    "iris chase": {
      "about": "a pinched iris travelling along the rig, each beam snapping open as the next closes, once a bar — choruses",
      "family": "beam"
    },
    "iris pulse": {
      "about": "every beam's iris pinching in and out together once a bar — choruses, a hit without touching the dimmer",
      "family": "beam"
    },
    "lift off": {
      "about": "the beams lifting off the stage and fading out as they rise, staying gone — the end of a section",
      "family": "one-shot"
    },
    "lightning": {
      "about": "scattered white flashes on the back wall with long dark gaps, each strike falling away — intros and breakdowns",
      "family": "intensity"
    },
    "lightning strike": {
      "about": "two white flashes, a third, and a dim afterglow fading over a bar — a single strike on a break or a crash",
      "family": "one-shot"
    },
    "meteor": {
      "about": "comets falling through the bars from scattered places every half bar — drops and last choruses",
      "family": "strip"
    },
    "mirror chase in": {
      "about": "two points of light closing from both edges to the centre once a bar — pre-choruses, symmetric rigs",
      "family": "intensity"
    },
    "mirror chase out": {
      "about": "two points of light leaving the centre for both edges once a bar — choruses, symmetric rigs",
      "family": "intensity"
    },
    "negative flash": {
      "about": "the whole stage cut to black for an instant and straight back — accents on a full stage where a bump has nowhere to go",
      "family": "one-shot"
    },
    "nod": {
      "about": "every beam dipping and lifting a little every half bar — choruses, the rig nodding along",
      "family": "movement"
    },
    "offset breathe": {
      "about": "a slow swell rolling across the wash over two bars — verses, the stage breathing in sequence",
      "family": "intensity"
    },
    "open out": {
      "about": "the wash filling from the centre to both edges over two bars — a chorus arriving, symmetric rigs",
      "family": "intensity"
    },
    "pair chase": {
      "about": "the chase in pairs, a wider point of light crossing the wash once a bar — choruses on a big wash",
      "family": "intensity"
    },
    "pan dim": {
      "about": "beams lit as they sweep one way and dark on the way back, so light only ever travels one direction — choruses",
      "family": "movement"
    },
    "pan fan": {
      "about": "the beams fanning apart from the centre and closing again every two bars — choruses, symmetric rigs",
      "family": "movement"
    },
    "pan sweep": {
      "about": "all the beams sweeping one way together and snapping back every two bars — choruses, one wall of light moving",
      "family": "movement"
    },
    "pan wave": {
      "about": "beams swinging side to side in sequence so a wave rolls along the truss every two bars — pre-choruses",
      "family": "movement"
    },
    "paparazzi": {
      "about": "blinders popping one at a time like camera flashes — bows, walk-ons and last choruses",
      "family": "intensity"
    },
    "pulse": {
      "about": "the whole wash swelling and settling together once a bar — choruses, the rig breathing with the beat",
      "family": "intensity"
    },
    "quarter chase": {
      "about": "every fourth light on in turn across the whole width, once a bar — driving choruses, keeps the stage covered",
      "family": "intensity"
    },
    "rainbow": {
      "about": "the spectrum laid along the wash and rolling across it over four bars — outros and party choruses",
      "family": "colour"
    },
    "rainbow scroll": {
      "about": "red, green and blue bands scrolling along the bars every two bars — party choruses and outros",
      "family": "strip"
    },
    "ramp pulse": {
      "about": "the wash snapping up on every beat and fading out before the next — drops and last choruses, a kick drum in light",
      "family": "intensity"
    },
    "random jump": {
      "about": "beams snapping to new positions one at a time in a scattered order — drops and breakdowns",
      "family": "movement"
    },
    "random strobe": {
      "about": "single lights flashing in a scattered order, chaos rather than a machine — drops and last choruses",
      "family": "intensity"
    },
    "random strobe pops": {
      "about": "single beams bursting into strobe for a moment in a scattered order — drops, sparse enough to stay a surprise",
      "family": "beam"
    },
    "rig build": {
      "about": "every layer of the rig filling light by light over four bars, then resetting — the riser into a last chorus",
      "family": "intensity"
    },
    "rig chase": {
      "about": "one point of light travelling across every layer of the rig every two bars — last choruses, the biggest chase there is",
      "family": "intensity"
    },
    "room circle": {
      "about": "every beam drawing a two metre circle on the floor round its aim over four bars, the same size at any venue — verses",
      "family": "movement"
    },
    "running sines": {
      "about": "two soft bumps of light gliding along the bars every two bars — verses and outros",
      "family": "strip"
    },
    "saturation breathe": {
      "about": "the look washing toward pastel and back to full colour over four bars — verses, felt not seen",
      "family": "colour"
    },
    "saw wave": {
      "about": "a ramp of light sliding along the wash and snapping back every two bars — post-choruses, harder than wave",
      "family": "intensity"
    },
    "scanner": {
      "about": "a comet running to the end of the bars and back, never jumping — verses and breakdowns",
      "family": "strip"
    },
    "scissor": {
      "about": "odd beams tilting up as even beams tilt down while a pan wave rolls along the truss every two bars — choruses, blades crossing",
      "family": "movement"
    },
    "see saw": {
      "about": "odds rising as evens fall in a smooth see-saw once a bar — verses and bridges, gentler than alternate",
      "family": "intensity"
    },
    "shimmer": {
      "about": "a tiny fast flicker across the wash like light on water — intros and ambient verses, barely there",
      "family": "intensity"
    },
    "snake": {
      "about": "a single light running to the end of the wash and back every half bar — breakdowns and intros",
      "family": "intensity"
    },
    "sparkle": {
      "about": "single lights twinkling across the wash in a scattered order — pre-choruses, outros and ballad choruses",
      "family": "intensity"
    },
    "spiral": {
      "about": "beams spiralling out from the focus in widening rings, then snapping back — pre-choruses and builds",
      "family": "movement"
    },
    "split swap": {
      "about": "one half of the stage in each palette colour, the halves swapping every two bars — post-choruses and bridges",
      "family": "colour"
    },
    "square path": {
      "about": "every beam tracing a box, corner to corner, every two bars — choruses that want a harder shape than a circle",
      "family": "movement"
    },
    "stab": {
      "about": "the whole stage jumping up for an eighth and straight back — accents on a stop or a stab",
      "family": "one-shot"
    },
    "strip chase": {
      "about": "every fourth pixel lit and running along the bars once a bar — choruses, the pixel chase",
      "family": "strip"
    },
    "strip drain": {
      "about": "the bars emptying from one end over a bar and staying dark — the end of a section",
      "family": "one-shot"
    },
    "strip fill": {
      "about": "the bars filling from one end over a bar and staying full — the top of a section or a riser",
      "family": "one-shot"
    },
    "strip strobe": {
      "about": "the whole strip flashing at eighths in whatever colour it was — peaks only, a few bars",
      "family": "strip"
    },
    "strip twinkle": {
      "about": "single pixels winking out of a lit strip in a scattered order like stars — intros and ballads",
      "family": "strip"
    },
    "strobe": {
      "about": "the wash flashing hard on and off at eighths — peaks only, a few bars at a time",
      "family": "intensity"
    },
    "strobe bed": {
      "about": "a slow shutter strobe swelling in and fading out of the look every two bars — bridges that want tension without a flash",
      "family": "beam"
    },
    "strobe burst": {
      "about": "everything strobing hard for one bar, then stopping — the drop, twice a song at most",
      "family": "one-shot"
    },
    "strobe chase": {
      "about": "a strobing beam travelling along the rig once a bar, the rest steady — last choruses",
      "family": "beam"
    },
    "strobe riser": {
      "about": "the beams' strobe climbing from nothing to full over eight bars and holding — under a riser, ended by the drop",
      "family": "one-shot"
    },
    "sway": {
      "about": "every beam swinging slowly side to side together over four bars — verses and ballads",
      "family": "movement"
    },
    "tap ballyhoo": {
      "about": "the ballyhoo on tap tempo — busking a set with no track running",
      "family": "movement"
    },
    "tap chase": {
      "about": "the chase on tap tempo — busking a set with no track running",
      "family": "intensity"
    },
    "tap circle": {
      "about": "the circle on tap tempo — busking a set with no track running",
      "family": "movement"
    },
    "tap pulse": {
      "about": "the pulse on tap tempo — busking a set with no track running",
      "family": "intensity"
    },
    "tap two colour": {
      "about": "the two colour chase on tap tempo — busking a set with no track running",
      "family": "colour"
    },
    "three colour chase": {
      "about": "three palette colours laid along the wash and walking across it every two bars — choruses",
      "family": "colour"
    },
    "tilt bounce": {
      "about": "beams dropping hard and bouncing back like a ball every half bar — drops and breakdowns",
      "family": "movement"
    },
    "tilt dim": {
      "about": "beams lit as they rise and dark as they fall, so light only ever climbs — builds and pre-choruses",
      "family": "movement"
    },
    "tilt fan": {
      "about": "beams lifting from the centre outward and settling back over four bars — bridges and pre-choruses",
      "family": "movement"
    },
    "tilt ripple": {
      "about": "one nod running along the line of beams and gone — fills and pickups",
      "family": "one-shot"
    },
    "tilt wave": {
      "about": "beams rising and falling in sequence so a wave rolls along the truss every two bars — pre-choruses and bridges",
      "family": "movement"
    },
    "tri wipe": {
      "about": "the hot colour sweeping along the bars with the deep colour behind it and dark behind that — a section change",
      "family": "one-shot"
    },
    "tv flicker": {
      "about": "the key light flickering unevenly like a television on a face, every fixture at its own rate — intros and spoken sections",
      "family": "intensity"
    },
    "two colour chase": {
      "about": "the palette's two colours trading places on odds and evens once a bar — breakdowns and post-choruses",
      "family": "colour"
    },
    "two colour fade": {
      "about": "the whole wash crossfading between the palette's two colours every two bars — verses and bridges",
      "family": "colour"
    },
    "wall bands": {
      "about": "three horizontal bands scrolling up the wash — a slow riser under a pre-chorus",
      "family": "matrix"
    },
    "wall rain": {
      "about": "drops falling down each column on its own offset — weather rather than a chase, and the one effect that reads as *down* on a tower wall",
      "family": "matrix"
    },
    "wall rain heavy": {
      "about": "the same rain twice as fast with more columns and a shorter tail — a downpour, for a drop or a breakdown's last bar",
      "family": "matrix"
    },
    "wall snake": {
      "about": "a head crawling a serpentine path across the wash with a fading tail — the matrix move, for a bridge or a breakdown that needs one thing happening",
      "family": "matrix"
    },
    "wall snake climb": {
      "about": "the same snake weaving up the columns instead of across the rows — reads as a climb on a rig with height, as a slow chase on one without",
      "family": "matrix"
    },
    "wall snake fast": {
      "about": "a short-tailed snake at a bar a lap — a last-chorus move, too busy for a verse",
      "family": "matrix"
    },
    "wall sparkle": {
      "about": "cells lighting at random across the wall and fading — a texture, not a move; safe under a verse",
      "family": "matrix"
    },
    "wall sweep": {
      "about": "every beam sweeping a three metre line across its aim and back every two bars — choruses, a wall of beams that stays a wall",
      "family": "movement"
    },
    "wall wipe": {
      "about": "one soft bar crossing the wash bottom to top — the simplest thing a wall can do that a row cannot",
      "family": "matrix"
    },
    "warm chase": {
      "about": "gold, amber, red and pink walking along the wash like a sunset over four bars — outros and warm bridges",
      "family": "colour"
    },
    "warm cool split": {
      "about": "warm and cool white trading on odds and evens every four bars — verses that want colour without colour",
      "family": "colour"
    },
    "wave": {
      "about": "a soft wave of light passing along the wash every two bars — pre-choruses and outros",
      "family": "intensity"
    },
    "white out": {
      "about": "the whole stage to full white for a bar, then released — the last hit of the song, once",
      "family": "one-shot"
    },
    "white pop": {
      "about": "a brief white flash through whatever colour the wash is in, once a bar — choruses, the cheapest accent there is",
      "family": "colour"
    },
    "windmill": {
      "about": "circles spread round the rig so the beams turn like spokes of a wheel — choruses and outros",
      "family": "movement"
    },
    "zoom pulse": {
      "about": "every beam opening and closing together once a bar — choruses, the beams breathing with the beat",
      "family": "beam"
    },
    "zoom snap": {
      "about": "beams snapping wide and closing slowly, odds against evens, once a bar — drops and heavy choruses",
      "family": "beam"
    },
    "zoom wave": {
      "about": "beams opening and closing in sequence so a wave of width rolls along the rig every two bars — pre-choruses",
      "family": "beam"
    }
  },
