  "name": "Ignition",
  "roles": [
    {
      "about": "Light on the performers' faces, from the front. Without it the audience cannot see who is playing, and no amount of colour elsewhere substitutes.",
      "kind": "Group",
      "name": "Key",
      "required": true
    },
    {
      "about": "The main colourable surface on stage. What carries the song's mood, and where a busking operator spends most of the night.",
      "kind": "Group",
      "name": "Wash",
      "required": true
    },
    {
      "about": "Anything behind the band — back wall, cyc, upstage bar. Separation from the background is the largest single difference between a rig that reads as designed and one that reads as switched on.",
      "kind": "Group",
      "name": "Back",
      "required": true
    },
    {
      "about": "Anything that pans and tilts.",
      "kind": "Group",
      "name": "Movers",
      "required": false
    },
    {
      "about": "Hard-edged movers, where they are a separate package from wash movers.",
      "kind": "Group",
      "name": "Beams",
      "required": false
    },
    {
      "about": "Pixel strips and battens — the accent layer, and where soft charted hits land.",
      "kind": "Group",
      "name": "Bars",
      "required": false
    },
    {
      "about": "Uplight and the floor package.",
      "kind": "Group",
      "name": "Floor",
      "required": false
    },
    {
      "about": "Blinders and audience wash.",
      "kind": "Group",
      "name": "Audience",
      "required": false
    },
    {
      "about": "The drum special.",
      "kind": "Group",
      "name": "Drums",
      "required": false
    },
    {
      "about": "A solo or follow.",
      "kind": "Group",
      "name": "Spot",
      "required": false
    },
    {
      "about": "Atmospherics. A beam is inert in clean air.",
      "kind": "Group",
      "name": "Haze",
      "required": false
    },
    {
      "about": "The lead position. A room that cannot say where its singer stands cannot host a show written for one.",
      "kind": "Focus",
      "name": "Vocal",
      "required": true
    },
    {
      "about": "The whole performance area.",
      "kind": "Focus",
      "name": "Stage",
      "required": true
    },
    {
      "about": "Out over the room.",
      "kind": "Focus",
      "name": "Audience",
      "required": true
    },
    {
      "about": "The upstage area.",
      "kind": "Focus",
      "name": "Band",
      "required": false
    },
    {
      "about": "The kit.",
      "kind": "Focus",
      "name": "Drums",
      "required": false
    },
    {
      "about": "The surface behind the band.",
      "kind": "Focus",
      "name": "Back Wall",
      "required": false
    },
    {
      "about": "Deep audience, past the front rows.",
      "kind": "Focus",
      "name": "House",
      "required": false
    },
    {
      "about": "The primary video surface. Required only of rooms that have screens at all — the show says 'play this on Main' and the venue decides whether that is one panel or three of unequal width.",
      "kind": "Canvas",
      "name": "Main",
      "required": false
    },
    {
      "about": "An independent flanking surface.",
      "kind": "Canvas",
      "name": "Side Left",
      "required": false
    },
    {
      "about": "An independent flanking surface.",
      "kind": "Canvas",
      "name": "Side Right",
      "required": false
    }
  ],
