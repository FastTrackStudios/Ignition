{
  "version": 1,
  "profile": "Ignition",
  "name": "Beam tests",
  "about": "A matrix for judging what the air looks like, one cue per case, not a look. Each cue isolates one thing a beam artefact is known to depend on: the angle between the camera ray and the beam, the beam's length, whether it is a mover or a par, and how many fixtures are lit at once. Render the lot with `just beam-matrix`, which contact-sheets both renderers side by side. The point of a matrix rather than one picture is that the two paths fail differently \u2014 the screen-space march beads a beam it crosses, the froxel grid softens one, and neither shows up in the case the other was tuned against.",
  "cues": [
    {
      "name": "vertical",
      "about": "Overhead movers straight down. The worst case for any raymarch: the camera ray crosses the beam's width rather than running along its length, so a beam is only as continuous as the sampling allows.",
      "fade_secs": 0.0,
      "block": true,
      "recipes": [
        {
          "target": {
            "Group": "Hazers"
          },
          "apply": {
            "Dimmer": 1.0
          }
        },
        {
          "target": {
            "Group": "OH Movers"
          },
          "steps": [
            {
              "apply": [
                {
                  "Dimmer": 1.0
                },
                {
                  "Color": "Open White"
                },
                {
                  "FocusPoint": [
                    0.0,
                    0.0,
                    0.0
                  ]
                }
              ],
              "width": 1.0,
              "transition": 0.0,
              "ease": "Linear"
            }
          ]
        }
      ]
    },
    {
      "name": "crossed steep",
